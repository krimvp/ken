{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "includes": ["**", "!!**/.agents", "!!**/third_party", "!!**/vendor", "!**/*.md"] },
	"formatter": { "indentStyle": "tab", "lineWidth": 120 },
	"javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
	"linter": {
		"rules": {
			"style": { "noNonNullAssertion": "error", "noDefaultExport": "error" },
			"nursery": { "noFloatingPromises": "error" }
		}
	},
	"overrides": [{ "includes": ["src/**"], "linter": { "rules": { "suspicious": { "noConsole": "error" } } } }]
}

{
	"name": "ken",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check --error-on-warnings .",
		"format": "biome check --write .",
		"test": "node --test 'test/**/*.test.ts'",
		"check:structure": "node scripts/check/structure.ts",
		"check:prose": "node scripts/check/prose.ts",
		"check": "npm run typecheck && npm run lint && npm test && npm run check:structure && npm run check:prose"
	},
	"dependencies": {
		"aigent": "file:vendor/aigent-0.0.0.tgz"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/node": "22.20.5",
		"typescript": "7.0.2"
	}
}

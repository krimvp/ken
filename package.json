{
	"name": "ken",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19"
	},
	"scripts": {
		"ken": "node --env-file-if-exists=.env src/cli/main.ts",
		"claude-endpoint": "node scripts/claude-endpoint/claude-endpoint.ts",
		"prepack": "node scripts/check-bundle.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check --error-on-warnings .",
		"format": "biome check --write .",
		"test": "node --import ./test/fixtures/git-identity.ts --test 'test/**/*.test.ts'",
		"check:structure": "node scripts/check/structure.ts",
		"check:prose": "node scripts/check/prose.ts",
		"bench": "node scripts/bench/run-questions.ts",
		"bench:check": "node scripts/bench/check-reply.ts",
		"check": "npm run typecheck && npm run lint && npm test && npm run check:structure && npm run check:prose"
	},
	"bin": {
		"ken": "bin/ken.js",
		"ken-claude-endpoint": "bin/ken-claude-endpoint.js"
	},
	"dependencies": {
		"aigent": "file:vendor/aigent-0.0.0.tgz",
		"mermaid": "11.17.2"
	},
	"bundleDependencies": [
		"aigent"
	],
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/node": "22.20.5",
		"typescript": "7.0.2"
	}
}

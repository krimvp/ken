# ken sends your project's code to the model you name here. It has no default model.
KEN_MODEL=gpt-oss:120b
KEN_BASE_URL=https://ollama.com/v1
# The name of the variable that holds the key, not the key itself.
KEN_API_KEY_ENV=OLLAMA_API_KEY
OLLAMA_API_KEY=
# Or ask Claude through the claude command on this machine. Start the endpoint first: npm run claude-endpoint
# KEN_MODEL=opus
# KEN_BASE_URL=http://127.0.0.1:4141/v1
# KEN_API_KEY_ENV=KEN_LOCAL_KEY
# KEN_LOCAL_KEY=not-a-key
